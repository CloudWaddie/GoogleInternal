{
  "name": "@cloudwaddie/googleinternal",
  "version": "1.2.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Node.js/TypeScript library for Google's internal batchexecute RPC protocol: SAPISIDHASH auth, spec registry, batching, streaming, and RPC scraping.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "scrape-rpc": "dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build",
    "scrape-rpc": "ts-node src/cli.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/estraverse": "^5.1.7",
    "@types/node": "^25.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "ast-types": "^0.16.1",
    "cli-progress": "^3.12.0",
    "estraverse": "^5.3.0",
    "meriyah": "^7.1.0",
    "recast": "^0.23.11",
    "undici": "^8.10.0",
    "zod": "^4.3.6"
  }
}
